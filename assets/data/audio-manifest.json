    {
      "id": "u01-dialog-001",
      "unitId": 1,
      "section": "dialog",
      "arabic": "الْمُحَاضِرَةُ: السَّلَامُ عَلَيْكُمْ، أَهْلًا وَسَهْلًا بِكُمْ فِي مُقَرَّرِ اللُّغَةِ الْعَرَبِيَّةِ لِلْمُعَامَلَاتِ.",
      "meaning": "Pensyarah: Assalamualaikum. Selamat datang ke kursus Bahasa Arab untuk Muamalat.",
      "gender": "female",
      "path": "/audio/unit-01/female/u01-dialog-001-female.wav",
      "status": "generated"
    },
    {
      "id": "u01-dialog-002",
      "unitId": 1,
      "section": "dialog",
      "arabic": "الطَّالِبُ: وَعَلَيْكُمُ السَّلَامُ. مَا مَوْضُوعَاتُ هَذَا الْمُقَرَّرِ؟",
      "meaning": "Pelajar: Waalaikumussalam. Apakah topik-topik dalam kursus ini?",
      "gender": "male",
      "path": "/audio/unit-01/male/u01-dialog-002-male.wav",
      "status": "generated"
    },
    {
      "id": "u01-dialog-003",
      "unitId": 1,
      "section": "dialog",
      "arabic": "الْمُحَاضِرَةُ: نَدْرُسُ الْمُفْرَدَاتِ وَالْحِوَارَ وَالْقَوَاعِدَ وَنُصُوصَ الْمُعَامَلَاتِ.",
      "meaning": "Pensyarah: Kita mempelajari mufradat perbualan tatabahasa dan teks muamalat.",
      "gender": "female",
      "path": "/audio/unit-01/female/u01-dialog-003-female.wav",
      "status": "generated"
    },
    {
      "id": "u01-dialog-004",
      "unitId": 1,
      "section": "dialog",
      "arabic": "الطَّالِبُ: هَلْ فِي الْمُقَرَّرِ وَاجِبٌ وَعَرْضٌ تَقْدِيمِيٌّ؟",
      "meaning": "Pelajar: Adakah kursus ini mempunyai tugasan dan pembentangan?",
      "gender": "male",
      "path": "/audio/unit-01/male/u01-dialog-004-male.wav",
      "status": "generated"
    },
    {
      "id": "u01-dialog-005",
      "unitId": 1,
      "section": "dialog",
      "arabic": "الْمُحَاضِرَةُ: نَعَمْ، فِيهِ اِخْتِبَارٌ وَوَاجِبٌ وَعَرْضٌ تَقْدِيمِيٌّ.",
      "meaning": "Pensyarah: Ya terdapat ujian tugasan dan pembentangan.",
      "gender": "female",
      "path": "/audio/unit-01/female/u01-dialog-005-female.wav",
      "status": "generated"
    },
    {
      "id": "u01-dialog-006",
      "unitId": 1,
      "section": "dialog",
      "arabic": "الطَّالِبُ: شُكْرًا. سَأَجْتَهِدُ فِي هَذَا الْمُقَرَّرِ.",
      "meaning": "Pelajar: Terima kasih. Saya akan berusaha bersungguh-sungguh dalam kursus ini.",
      "gender": "male",
      "path": "/audio/unit-01/male/u01-dialog-006-male.wav",
      "status": "generated"
    },
    {
      "id": "u01-reading",
