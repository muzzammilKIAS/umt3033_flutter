    "dialog": [
      {
        "id": "u01-dialog-001",
        "arabic": "الْمُحَاضِرَةُ: السَّلَامُ عَلَيْكُمْ، أَهْلًا وَسَهْلًا بِكُمْ فِي مُقَرَّرِ اللُّغَةِ الْعَرَبِيَّةِ لِلْمُعَامَلَاتِ.",
        "meaning": "Pensyarah: Assalamualaikum. Selamat datang ke kursus Bahasa Arab untuk Muamalat.",
        "speakerLabel": "Pensyarah",
        "speakerAr": "الْمُحَاضِرَةُ",
        "gender": "female"
      },
      {
        "id": "u01-dialog-002",
        "arabic": "الطَّالِبُ: وَعَلَيْكُمُ السَّلَامُ. مَا مَوْضُوعَاتُ هَذَا الْمُقَرَّرِ؟",
        "meaning": "Pelajar: Waalaikumussalam. Apakah topik-topik dalam kursus ini?",
        "speakerLabel": "Pelajar",
        "speakerAr": "الطَّالِبُ",
        "gender": "male"
      },
      {
        "id": "u01-dialog-003",
        "arabic": "الْمُحَاضِرَةُ: نَدْرُسُ الْمُفْرَدَاتِ وَالْحِوَارَ وَالْقَوَاعِدَ وَنُصُوصَ الْمُعَامَلَاتِ.",
        "meaning": "Pensyarah: Kita mempelajari mufradat perbualan tatabahasa dan teks muamalat.",
        "speakerLabel": "Pensyarah",
        "speakerAr": "الْمُحَاضِرَةُ",
        "gender": "female"
      },
      {
        "id": "u01-dialog-004",
        "arabic": "الطَّالِبُ: هَلْ فِي الْمُقَرَّرِ وَاجِبٌ وَعَرْضٌ تَقْدِيمِيٌّ؟",
        "meaning": "Pelajar: Adakah kursus ini mempunyai tugasan dan pembentangan?",
        "speakerLabel": "Pelajar",
        "speakerAr": "الطَّالِبُ",
        "gender": "male"
      },
      {
        "id": "u01-dialog-005",
        "arabic": "الْمُحَاضِرَةُ: نَعَمْ، فِيهِ اِخْتِبَارٌ وَوَاجِبٌ وَعَرْضٌ تَقْدِيمِيٌّ.",
        "meaning": "Pensyarah: Ya terdapat ujian tugasan dan pembentangan.",
        "speakerLabel": "Pensyarah",
        "speakerAr": "الْمُحَاضِرَةُ",
        "gender": "female"
      },
      {
        "id": "u01-dialog-006",
        "arabic": "الطَّالِبُ: شُكْرًا. سَأَجْتَهِدُ فِي هَذَا الْمُقَرَّرِ.",
        "meaning": "Pelajar: Terima kasih. Saya akan berusaha bersungguh-sungguh dalam kursus ini.",
        "speakerLabel": "Pelajar",
        "speakerAr": "الطَّالِبُ",
        "gender": "male"
      }
    ],
    "dialogInstructionAr": "",
    "readingAr": "مُقَرَّرُ اللُّغَةِ الْعَرَبِيَّةِ لِلْمُعَامَلَاتِ مُقَرَّرٌ أَسَاسِيٌّ لِطُلَّابِ الْمُعَامَلَاتِ وَالْمَالِيَّةِ الْإِسْلَامِيَّةِ. يَتَعَلَّمُ الطَّالِبُ فِيهِ الْمُفْرَدَاتِ وَالْقَوَاعِدَ الْأَسَاسِيَّةَ، وَيَقْرَأُ نُصُوصًا قَصِيرَةً، وَيُجْرِي حِوَارَاتٍ فِي مَوْضُوعَاتٍ مِثْلَ الْمَصْرِفِ وَالِاسْتِثْمَارِ وَالزَّكَاةِ وَالتَّكَافُلِ. وَيَجْتَهِدُ الطَّالِبُ فِي التَّعَلُّمِ، وَيَسْتَعْمِلُ اللُّغَةَ الْعَرَبِيَّةَ فِي دِرَاسَتِهِ.\nMaksud: Kursus Bahasa Arab untuk Muamalat ialah kursus asas bagi pelajar muamalat dan kewangan Islam. Pelajar mempelajari mufradat dan tatabahasa asas membaca teks pendek serta menjalankan perbualan tentang topik seperti bank pelaburan zakat dan takaful. Pelajar berusaha dalam pembelajaran dan menggunakan Bahasa Arab dalam pengajiannya.",
    "readingMs": "Kursus Bahasa Arab untuk Muamalat merupakan kursus asas untuk pelajar bidang muamalat dan kewangan Islam. Pelajar mempelajari kosa kata, kaedah tatabahasa asas dan teks bacaan ringkas berkaitan muamalat. Kursus ini juga melatih kemahiran perbualan, penulisan dan pemahaman istilah dalam Bahasa Arab. Semua pelajar digalakkan menyertai aktiviti tugasan dan pembentangan dalam kursus ini.",
    "hadithAr": "قَالَ رَسُولُ اللهِ ﷺ \"مَنْ سَلَكَ طَرِيقًا يَلْتَمِسُ فِيهِ عِلْمًا، سَهَّلَ اللَّهُ لَهُ بِهِ طَرِيقًا إِلَى الْجَنَّةِ\"\nصَحِيحُ مُسْلِمٍ، رَقْمُ ٢٦٩٩.\nMaksud: “Sesiapa yang menempuh suatu jalan untuk mencari ilmu, Allah memudahkan baginya jalan menuju syurga.”",
    "hadithSource": "",
    "hadithMaksud": "",
    "hadithLessons": [
      "يَحْتَاجُ طَلَبُ الْعِلْمِ إِلَى الْجِدِّ وَالِاجْتِهَادِ.",
      "يَنْبَغِي أَنْ يُعْمَلَ بِالْعِلْمِ النَّافِعِ بِأَمَانَةٍ.",
      "عَلَى الطَّالِبِ أَنْ يَلْتَزِمَ بِالْأَدَبِ وَالِانْضِبَاطِ وَالتَّعَاوُنِ طَوَالَ الْمُقَرَّرِ."
    ],
    "exercisesAr": "أَجِبْ عَنِ الْأَسْئِلَةِ الْآتِيَةِ جَمِيعِهَا:\n١. صِلْ سِتَّ مُفْرَدَاتٍ عَرَبِيَّةٍ بِمَعَانِيهَا الصَّحِيحَةِ.\n٢. اُذْكُرْ أَرْبَعَةَ مُكَوِّنَاتٍ يَتَعَلَّمُهَا الطَّالِبُ فِي هَذَا الْمُقَرَّرِ.\n٣. كَوِّنْ جُمْلَتَيْنِ بَسِيطَتَيْنِ بِاسْتِعْمَالِ كَلِمَتَيْ مُقَرَّرٌ وَطَالِبٌ.\n٤. عَرِّفْ بِنَفْسِكَ بِاللُّغَةِ الْعَرَبِيَّةِ، وَاذْكُرِ اسْمَكَ وَبَرْنَامَجَ دِرَاسَتِكَ وَمَا تَرْجُوهُ مِنَ الْمُقَرَّرِ.\n٥. نَاقِشْ مَعَ زُمَلَائِكَ مَوْضُوعًا وَاحِدًا مِنْ مَوْضُوعَاتِ الْمُعَامَلَاتِ يَصْلُحُ لِلْعَرْضِ الْجَمَاعِيِّ.",
    "exercises": [
      "[PERLU SEMAKAN PENSYARAH]"
    ],
    "summaryAr": "",
    "summary": "Pelajar telah mengenali objektif kursus, skop pembelajaran dan kaedah penilaian. Pelajar juga mempelajari kosa kata asas dan ungkapan yang digunakan pada hari pertama kuliah.",
    "assessmentAr": "ضَعْ عَلَامَةَ (✓) أَمَامَ الْعِبَارَاتِ الَّتِي أَتْقَنْتَهَا:\n☐ أَسْتَطِيعُ أَنْ أُبَيِّنَ أَهْدَافَ الْمُقَرَّرِ.\n☐ أَسْتَطِيعُ أَنْ أَذْكُرَ ثَمَانِيَ مُفْرَدَاتٍ عَلَى الْأَقَلِّ فِي مَوْضُوعِ التَّعَلُّمِ.\n☐ أَسْتَطِيعُ أَنْ أُعَرِّفَ بِنَفْسِي تَعْرِيفًا مُخْتَصَرًا بِاللُّغَةِ الْعَرَبِيَّةِ.\n☐ أَفْهَمُ مَسْؤُولِيَّتِي نَحْوَ الِاخْتِبَارَاتِ الْقَصِيرَةِ وَالِاخْتِبَارِ وَالْعَرْضِ التَّقْدِيمِيِّ.",
    "assessmentItems": [
      "أَسْتَطِيعُ أَنْ أُبَيِّنَ أَهْدَافَ الْمُقَرَّرِ.",
      "أَسْتَطِيعُ أَنْ أَذْكُرَ ثَمَانِيَ مُفْرَدَاتٍ عَلَى الْأَقَلِّ فِي مَوْضُوعِ التَّعَلُّمِ.",
      "أَسْتَطِيعُ أَنْ أُعَرِّفَ بِنَفْسِي تَعْرِيفًا مُخْتَصَرًا بِاللُّغَةِ الْعَرَبِيَّةِ.",
      "أَفْهَمُ مَسْؤُولِيَّتِي نَحْوَ الِاخْتِبَارَاتِ الْقَصِيرَةِ وَالِاخْتِبَارِ وَالْعَرْضِ التَّقْدِيمِيِّ."
    ],
